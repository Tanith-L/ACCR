{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tanith-L/ACCR/schema/content.schema.json",
  "title": "RheumNotes content export (Data -> Backend contract)",
  "description": "One file per export run. Cross-references (every *_id exists, no duplicate IDs, subtopic lesson_ids exist) and the checked gate are verified by the import script, not by this schema. Word-count limits (title, topic names, page bodies, questions, alt text) are guidance in docs/content-json-schema.md and are not enforced here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "disease",
    "sources",
    "topics",
    "lessons",
    "quizzes",
    "media"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "model",
        "prompt_version",
        "generated_at"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "disease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topic"
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lesson"
      }
    },
    "quizzes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quiz"
      }
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/media"
      },
      "description": "Media registry; may be empty when no navigation or lesson images are supplied. Image map fields and lesson images are optional."
    },
    "course_map": {
      "$ref": "#/$defs/courseMap",
      "description": "Optional. Omit for a text/card course home generated from topics. If present, all image and topic-hotspot fields are required."
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"enum": ["1.0", "1.1", "1.2"]}}},
      "then": {"properties": {"lessons": {"items": {"properties": {"claims": {"items": {"$ref": "#/$defs/claim"}}}}}}}
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "properties": {
          "topics": {
            "items": {
              "not": {
                "required": [
                  "image_map"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "1.0",
              "1.1"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "course_map"
          ]
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "draftOrChecked": {
      "description": "The pipeline may only export draft or checked. reviewed and published are set by the review import.",
      "enum": [
        "draft",
        "checked"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "type",
        "provided_by",
        "file_hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "pdf",
            "docx",
            "image",
            "web"
          ]
        },
        "provided_by": {
          "type": "string",
          "minLength": 1
        },
        "file_hash": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$",
          "description": "SHA-256 of the source file."
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "order",
        "subtopics"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_map": {
          "$ref": "#/$defs/imageMap",
          "description": "Optional. Omit to render subtopics and their lesson_ids as a list. An image map is only needed for an illustrated clickable topic."
        },
        "subtopics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "order",
              "lesson_ids"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "lesson_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        }
      }
    },
    "imageMap": {
      "description": "Optional topic navigation image (schema 1.1 or later). The field itself may be omitted; when supplied it must include a real media reference, dimensions, hash and hotspots. Coordinates refer to the complete uncropped image.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_id",
        "image_width",
        "image_height",
        "image_sha256",
        "hotspots"
      ],
      "properties": {
        "media_id": {
          "$ref": "#/$defs/id"
        },
        "image_width": {
          "type": "integer",
          "minimum": 1
        },
        "image_height": {
          "type": "integer",
          "minimum": 1
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Binds coordinates to the exact deployed image bytes."
        },
        "hotspots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/imageHotspot"
          }
        }
      }
    },
    "imageHotspot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "lesson_id",
        "shape"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "lesson_id": {
          "$ref": "#/$defs/id"
        },
        "shape": {
          "enum": [
            "rect",
            "polygon"
          ]
        },
        "bounds": {
          "$ref": "#/$defs/normalizedRect"
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "shape": {
              "const": "rect"
            }
          },
          "required": [
            "bounds"
          ],
          "not": {
            "required": [
              "points"
            ]
          }
        },
        {
          "properties": {
            "shape": {
              "const": "polygon"
            }
          },
          "required": [
            "points"
          ],
          "not": {
            "required": [
              "bounds"
            ]
          }
        }
      ]
    },
    "normalizedRect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topic_id",
        "subtopic_id",
        "title",
        "est_minutes",
        "pages",
        "key_takeaways",
        "claims",
        "checks",
        "generated_by",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "psa-<topic>-<nn>, e.g. psa-dx-01"
        },
        "topic_id": {
          "$ref": "#/$defs/id"
        },
        "subtopic_id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "est_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "order",
              "body"
            ],
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "body": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "key_takeaways": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "media_id",
              "page"
            ],
            "properties": {
              "media_id": {
                "$ref": "#/$defs/id"
              },
              "page": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "description": "Optional lesson illustrations; independent of optional course/topic navigation images."
        },
        "claims": {
          "type": "array",
          "items": {
            "oneOf": [{"$ref": "#/$defs/claim"}, {"$ref": "#/$defs/provenanceClaim"}]
          },
          "description": "Factual assertions, or (schema 1.3+) explicitly typed editorial provenance records. Provenance is not a source quote or a passed credibility check."
        },
        "checks": {
          "$ref": "#/$defs/checks"
        },
        "generated_by": {
          "enum": [
            "llm",
            "human",
            "llm+edited"
          ]
        },
        "status": {
          "$ref": "#/$defs/draftOrChecked"
        }
      }
    },
    "provenanceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "references", "source_usage"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+-c[0-9]+$"},
        "kind": {"const": "provenance"},
        "references": {"type": "array", "items": {"$ref": "#/$defs/bibliographicReference"}},
        "source_usage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceUsage"}}
      }
    },
    "bibliographicReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https?://[^\\s]+$"}
      }
    },
    "sourceUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "pages", "kind", "locator", "contribution", "limits"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "pages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "kind": {"enum": ["text", "image", "text_and_image"]},
        "locator": {"type": "string", "minLength": 1},
        "contribution": {"type": "string", "minLength": 1},
        "limits": {"type": "string", "minLength": 1}
      },
      "description": "Editorial source correspondence. pages means LESSON pages, and locator may be a heading or DOCX paragraph; neither is a physical source_page or a verbatim quote."
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "page",
        "source_id",
        "source_page",
        "source_quote",
        "support",
        "quote_match"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+-c[0-9]+$",
          "description": "<lesson id>-c<n>"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "source_page": {
          "type": "integer",
          "minimum": 1
        },
        "source_quote": {
          "type": "string",
          "minLength": 1
        },
        "support": {
          "enum": [
            "supported",
            "unsupported",
            "contradicted"
          ]
        },
        "quote_match": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "checks": {
      "description": "Credibility check results. Only schema_valid is required so that existing human-written content with readability scores only can be exported; missing gate fields keep a lesson at draft on import. checked requires: schema_valid, contradicted = 0, unsupported = 0, citation_accuracy = 1.0, numbers_ok, empty safety_flags, fk_grade <= 8.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_valid"
      ],
      "properties": {
        "schema_valid": {
          "type": "boolean"
        },
        "citation_accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "claims_total": {
          "type": "integer",
          "minimum": 0
        },
        "supported": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "contradicted": {
          "type": "integer",
          "minimum": 0
        },
        "numbers_ok": {
          "type": "boolean"
        },
        "safety_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fk_grade": {
          "type": "number"
        },
        "smog": {
          "type": "number"
        },
        "coverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "quiz": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lesson_id",
        "question",
        "options",
        "answer",
        "feedback",
        "source_id",
        "source_page",
        "source_quote",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+-q[0-9]+$",
          "description": "<lesson id>-q<n>"
        },
        "lesson_id": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Index of the correct option; the import script checks it is less than len(options)."
        },
        "feedback": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "source_page": {
          "type": "integer",
          "minimum": 1
        },
        "source_quote": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/draftOrChecked"
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "alt_text",
        "credit",
        "source_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "file": {
          "type": "string",
          "pattern": "\\.(png|jpe?g)$",
          "description": "PNG/JPG shipped next to the JSON."
        },
        "alt_text": {
          "type": "string",
          "minLength": 1
        },
        "credit": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "courseMap": {
      "description": "Course overview navigation to topics, not lessons. Requires schema_version 1.2.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_id",
        "image_width",
        "image_height",
        "image_sha256",
        "hotspots"
      ],
      "properties": {
        "media_id": {
          "$ref": "#/$defs/id"
        },
        "image_width": {
          "type": "integer",
          "minimum": 1
        },
        "image_height": {
          "type": "integer",
          "minimum": 1
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Binds coordinates to the exact deployed image bytes."
        },
        "hotspots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/topicHotspot"
          }
        }
      }
    },
    "topicHotspot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "topic_id",
        "shape"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "enum": [
            "rect",
            "polygon"
          ]
        },
        "bounds": {
          "$ref": "#/$defs/normalizedRect"
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "topic_id": {
          "$ref": "#/$defs/id"
        }
      },
      "oneOf": [
        {
          "properties": {
            "shape": {
              "const": "rect"
            }
          },
          "required": [
            "bounds"
          ],
          "not": {
            "required": [
              "points"
            ]
          }
        },
        {
          "properties": {
            "shape": {
              "const": "polygon"
            }
          },
          "required": [
            "points"
          ],
          "not": {
            "required": [
              "bounds"
            ]
          }
        }
      ]
    }
  }
}
