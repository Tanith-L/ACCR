# Copy to frontend/.env.local (git-ignored). EXPO_PUBLIC_* values are bundled into the app,
# so only ever put the ANON key here, never the service key.

# mock = read data/output/psa_legacy.json, shows drafts with a preview banner (demo/review environment)
# supabase = read the published v_* views (patient environment)
EXPO_PUBLIC_CONTENT_SOURCE=mock

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Public Storage bucket holding the files in /media
EXPO_PUBLIC_MEDIA_BASE_URL=https://YOUR-PROJECT.supabase.co/storage/v1/object/public/media

# Mock only: simulated latency in ms, and set to 1 to make every request fail (tests error states)
EXPO_PUBLIC_MOCK_DELAY_MS=400
EXPO_PUBLIC_MOCK_FAIL=0
