# Copy to frontend/.env.local (git-ignored). EXPO_PUBLIC_* values are bundled into the app,
# so only ever put the ANON key here, never the service key or database URL.

# mock = answer every request from backend/fixtures/mock_responses (no backend needed)
# preview = real lessons from the Data pipeline's exports in data/psa, drafts included
#           (not clinically reviewed: team review only, never a patient build)
# supabase = the live API in backend/docs/api-contract.md
EXPO_PUBLIC_CONTENT_SOURCE=mock

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mock and preview only: simulated latency in ms, and an error to return from every request
# to test the error states: network | 400 | 401 (empty = no error)
EXPO_PUBLIC_MOCK_DELAY_MS=400
EXPO_PUBLIC_MOCK_FAIL=
