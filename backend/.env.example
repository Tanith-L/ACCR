# Copy to backend/.env (git-ignored). Never commit real keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service key: import / review / publish scripts only. Bypasses RLS. Team machines + GitHub secrets only.
SUPABASE_SERVICE_ROLE_KEY=
# Anon key: same one the app uses. Used by the access-control tests.
SUPABASE_ANON_KEY=
