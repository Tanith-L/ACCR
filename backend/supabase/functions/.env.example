# Rheumy chatbot Edge Function secrets (docs/rheumy-chatbot.md).
#
# Hosted project:  npx supabase@2 secrets set --env-file backend/supabase/functions/.env --project-ref <ref>
# Local serving:   copy to backend/supabase/functions/.env (git-ignored) and run
#                  npx supabase@2 functions serve --workdir backend --env-file backend/supabase/functions/.env
# These are server-side secrets: never put them in frontend/.env.local or any EXPO_PUBLIC_ variable.
# SUPABASE_URL and the project keys are provided to Edge Functions automatically.

# Groq (LLM). Create at https://console.groq.com/keys
GROQ_API_KEY=
# Optional; default openai/gpt-oss-120b
GROQ_MODEL=

# Azure AI Speech (Ava, Jenny, Emma voices). Azure portal > your Speech resource > Keys and Endpoint
AZURE_SPEECH_KEY=
# The resource's region, e.g. eastus
AZURE_SPEECH_REGION=

# Kokoro voice service for Heart and Bella (services/kokoro-tts). Optional: without it
# those two voices say "not set up" and Ava, Jenny and Emma still work.
KOKORO_TTS_URL=
# A long random string; the same value must be set on the Kokoro service.
KOKORO_TTS_KEY=

# Comma-separated browser origins allowed to call the functions, e.g.
# https://rheumnotes.example.org,http://localhost:8081   (empty or * = any origin)
RHEUMY_ALLOWED_ORIGINS=
