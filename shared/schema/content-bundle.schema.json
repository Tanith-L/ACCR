{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rheumnotes.local/schema/content-bundle/1.0.json",
  "title": "RheumNotes content bundle",
  "description": "Output of the Data pipeline and input of the Backend importer. One bundle = one disease. Statuses here are only 'draft' or 'checked'; 'reviewed' and 'published' exist only in the database. See docs/content-schema.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "pipeline_run", "disease", "sources", "topics", "lessons"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "pipeline_run": { "$ref": "#/$defs/pipelineRun" },
    "disease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "topics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/topic" } },
    "lessons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lesson" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 1 },

    "pipelineRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "mode", "started_at", "finished_at"],
      "properties": {
        "run_id": { "$ref": "#/$defs/nonEmpty" },
        "mode": { "enum": ["ai", "legacy", "manual"] },
        "model": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "duration_seconds": { "type": ["number", "null"], "minimum": 0 },
        "source_document_ids": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
        "usage": {
          "description": "Optional token usage for the AI-efficiency evaluation.",
          "type": ["object", "null"],
          "properties": {
            "input_tokens": { "type": "integer" },
            "output_tokens": { "type": "integer" }
          }
        }
      }
    },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "file": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "media_type": { "type": ["string", "null"] },
        "credit": { "type": ["string", "null"] }
      }
    },

    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "order", "subtopics"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "order": { "$ref": "#/$defs/order" },
        "icon": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "subtopics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/subtopic" } }
      }
    },

    "subtopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "order", "lesson_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "order": { "$ref": "#/$defs/order" },
        "lesson_ids": {
          "description": "Lesson IDs in learning order. Must match lessons[].order.",
          "type": "array",
          "items": { "$ref": "#/$defs/slug" },
          "uniqueItems": true
        }
      }
    },

    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "topic_id", "subtopic_id", "order", "title", "summary",
        "est_minutes", "body_markdown", "key_takeaways", "images", "source_refs",
        "status", "origin", "claims", "checks", "quiz"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "version": { "type": "integer", "minimum": 1 },
        "topic_id": { "$ref": "#/$defs/slug" },
        "subtopic_id": { "$ref": "#/$defs/slug" },
        "order": { "$ref": "#/$defs/order" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "summary": { "$ref": "#/$defs/nonEmpty" },
        "est_minutes": { "type": "integer", "minimum": 1, "maximum": 30 },
        "body_markdown": { "$ref": "#/$defs/nonEmpty" },
        "key_takeaways": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "images": { "type": "array", "items": { "$ref": "#/$defs/image" } },
        "source_refs": {
          "description": "Traceability: every lesson must cite at least one source.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "status": {
          "description": "draft = failed at least one automatic check; checked = passed all checks and is ready for clinical review.",
          "enum": ["draft", "checked"]
        },
        "origin": { "enum": ["ai_generated", "ai_assisted", "human_authored"] },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/checkResult" } },
        "quiz": { "type": "array", "items": { "$ref": "#/$defs/quizQuestion" } }
      }
    },

    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "alt_text"],
      "properties": {
        "file": { "$ref": "#/$defs/nonEmpty" },
        "alt_text": { "$ref": "#/$defs/nonEmpty" },
        "credit": { "type": ["string", "null"] },
        "page": { "type": ["integer", "null"] }
      }
    },

    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "pages"],
      "properties": {
        "source_id": { "$ref": "#/$defs/slug" },
        "pages": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "excerpt": { "type": ["string", "null"] }
      }
    },

    "claim": {
      "description": "A clinical statement made in the lesson, with the source that supports it. Not shown to patients.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source_id", "supported"],
      "properties": {
        "text": { "$ref": "#/$defs/nonEmpty" },
        "source_id": { "$ref": "#/$defs/slug" },
        "page": { "type": ["integer", "null"] },
        "supported": {
          "description": "true = verified against the source, false = not supported, null = not yet verified.",
          "type": ["boolean", "null"]
        }
      }
    },

    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "passed"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "passed": { "type": "boolean" },
        "detail": { "type": ["string", "null"] }
      }
    },

    "quizQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "options", "answer"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "question": { "$ref": "#/$defs/nonEmpty" },
        "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/nonEmpty" } },
        "answer": { "type": "integer", "minimum": 0 },
        "feedback": { "type": ["string", "null"] },
        "source_id": { "type": ["string", "null"] }
      }
    }
  }
}
